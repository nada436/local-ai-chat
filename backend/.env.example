# Server
PORT=5000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
VISION_MODEL=llava

# ChromaDB
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=local_ai_chat_kb

# RAG defaults (overridable from Settings UI, stored in config/settings.json)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
TEMPERATURE=0.2
MAX_TOKENS=1024

# Whisper (speech-to-text) - local model name used by nodejs-whisper
WHISPER_MODEL=base.en

# Uploads
MAX_FILE_SIZE_MB=25
